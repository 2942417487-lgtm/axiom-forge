{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom-forge.invalid/schemas/tool_result.schema.json",
  "title": "tool_result",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "result_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/artifact_id"
    },
    "call_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/artifact_id"
    },
    "world_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/world_id"
    },
    "task_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/task_id"
    },
    "run_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/run_id"
    },
    "agent_run_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/agent_run_id"
    },
    "canon_version": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/canon_version"
    },
    "tool_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "unavailable",
        "denied"
      ]
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt": {
      "type": "object",
      "properties": {
        "started_at": {
          "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/datetime"
        },
        "finished_at": {
          "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/datetime"
        },
        "arguments_sha256": {
          "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/sha256"
        },
        "payload_sha256": {
          "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "started_at",
        "finished_at",
        "arguments_sha256",
        "payload_sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "result_id",
    "call_id",
    "world_id",
    "task_id",
    "run_id",
    "agent_run_id",
    "canon_version",
    "tool_name",
    "status",
    "data",
    "error",
    "receipt"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "type": "object"
          }
        }
      }
    }
  ]
}
