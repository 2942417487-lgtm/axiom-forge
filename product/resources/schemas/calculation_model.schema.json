{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom-forge.invalid/schemas/calculation_model.schema.json",
  "title": "calculation_model",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "model_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "request_schema_versions": {
      "type": "array",
      "items": {
        "const": "1.0"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "parameter_contract": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "data_type": {
            "enum": [
              "scalar",
              "integer",
              "vector",
              "matrix",
              "text",
              "boolean"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "data_type",
          "unit",
          "description",
          "required"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "output_contract": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "data_type": {
            "enum": [
              "scalar",
              "integer",
              "vector",
              "matrix",
              "text",
              "boolean"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "data_type",
          "unit",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "implementations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "engine": {
            "enum": [
              "python",
              "matlab",
              "other"
            ]
          },
          "status": {
            "enum": [
              "planned",
              "ready"
            ]
          },
          "entrypoint": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "source_artifact_id": {
            "anyOf": [
              {
                "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/artifact_id"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_sha256": {
            "anyOf": [
              {
                "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "engine",
          "status",
          "entrypoint",
          "source_artifact_id",
          "source_sha256"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "planned"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "entrypoint": {
                  "type": "null"
                },
                "source_artifact_id": {
                  "type": "null"
                },
                "source_sha256": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ready"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "entrypoint": {
                  "type": "string",
                  "minLength": 1
                },
                "source_artifact_id": {
                  "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/artifact_id"
                },
                "source_sha256": {
                  "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/sha256"
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "metadata": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/metadata"
    }
  },
  "required": [
    "schema_version",
    "model_id",
    "model_version",
    "description",
    "request_schema_versions",
    "parameter_contract",
    "output_contract",
    "implementations",
    "assumptions",
    "limitations",
    "metadata"
  ],
  "additionalProperties": false
}
