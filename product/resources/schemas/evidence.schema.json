{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom-forge.invalid/schemas/evidence.schema.json",
  "title": "evidence",
  "type": "object",
  "properties": {
    "evidence_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/evidence_id"
    },
    "claim_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/claim_id"
    },
    "source": {
      "type": "object",
      "properties": {
        "source_type": {
          "enum": [
            "paper",
            "technical_documentation",
            "dataset",
            "experiment",
            "industrial_report",
            "book",
            "other",
            "test_fixture"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "journal_or_conference": {
          "type": [
            "string",
            "null"
          ]
        },
        "year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9999
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "anyOf": [
            {
              "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_type",
        "title",
        "url",
        "authors",
        "journal_or_conference",
        "year",
        "doi",
        "date"
      ],
      "additionalProperties": false
    },
    "field": {
      "type": "string",
      "minLength": 1
    },
    "what_was_actually_demonstrated": {
      "type": "string",
      "minLength": 1
    },
    "applicable_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "what_it_does_not_demonstrate": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "confidence": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/confidence"
    },
    "confidence_rationale": {
      "type": "string",
      "minLength": 1
    },
    "supported_claims": {
      "type": "array",
      "items": {
        "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/claim_id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "supported_entities": {
      "type": "array",
      "items": {
        "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/entity_id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "source_read",
            "synthetic"
          ]
        },
        "accessed_at": {
          "anyOf": [
            {
              "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/datetime"
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "accessed_at",
        "method",
        "locator",
        "excerpt"
      ],
      "additionalProperties": false
    },
    "last_updated": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/datetime"
    }
  },
  "required": [
    "evidence_id",
    "claim_id",
    "source",
    "field",
    "what_was_actually_demonstrated",
    "applicable_conditions",
    "what_it_does_not_demonstrate",
    "confidence",
    "confidence_rationale",
    "supported_claims",
    "supported_entities",
    "verification",
    "last_updated"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "source_type": {
                "const": "paper"
              }
            },
            "required": [
              "source_type"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "authors": {
                "minItems": 1
              },
              "journal_or_conference": {
                "type": "string",
                "minLength": 1
              },
              "year": {
                "type": "integer"
              },
              "doi": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "status": {
                "const": "source_read"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "verification"
        ]
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "accessed_at": {
                "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/datetime"
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "excerpt": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "source_type": {
                "const": "test_fixture"
              }
            },
            "required": [
              "source_type"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "status": {
                "const": "synthetic"
              }
            }
          }
        }
      }
    }
  ]
}
