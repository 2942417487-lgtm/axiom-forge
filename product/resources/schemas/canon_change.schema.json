{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom-forge.invalid/schemas/canon_change.schema.json",
  "title": "canon_change",
  "type": "object",
  "properties": {
    "proposal_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/proposal_id"
    },
    "world_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/world_id"
    },
    "task_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/task_id"
    },
    "run_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/run_id"
    },
    "base_canon_version": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/canon_version"
    },
    "operation": {
      "enum": [
        "add",
        "update",
        "delete"
      ]
    },
    "target_entity_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/entity_id"
    },
    "before": {
      "anyOf": [
        {
          "$ref": "https://axiom-forge.invalid/schemas/canon_entry.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "after": {
      "anyOf": [
        {
          "$ref": "https://axiom-forge.invalid/schemas/canon_entry.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/evidence_id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1
        },
        "counterexamples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "evidence_ids",
        "reasoning",
        "assumptions",
        "uncertainty",
        "counterexamples"
      ],
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "anyOf": [
            {
              "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/datetime"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision_id": {
          "anyOf": [
            {
              "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/entity_id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "reviewer",
        "reviewed_at",
        "decision_id"
      ],
      "additionalProperties": false
    },
    "created_at": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/datetime"
    }
  },
  "required": [
    "proposal_id",
    "world_id",
    "task_id",
    "run_id",
    "base_canon_version",
    "operation",
    "target_entity_id",
    "before",
    "after",
    "rationale",
    "provenance",
    "approval",
    "created_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "add"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "before": {
            "type": "null"
          },
          "after": {
            "$ref": "https://axiom-forge.invalid/schemas/canon_entry.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "update"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "before": {
            "$ref": "https://axiom-forge.invalid/schemas/canon_entry.schema.json"
          },
          "after": {
            "$ref": "https://axiom-forge.invalid/schemas/canon_entry.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "delete"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "before": {
            "$ref": "https://axiom-forge.invalid/schemas/canon_entry.schema.json"
          },
          "after": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approval": {
            "properties": {
              "status": {
                "enum": [
                  "approved",
                  "rejected"
                ]
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "approval"
        ]
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/datetime"
              },
              "decision_id": {
                "type": "string",
                "pattern": "^DEC-"
              }
            }
          }
        }
      }
    }
  ]
}
