    {
      "type": "object",
      "properties": {
        "mode": {
          "const": "scenario_simulation"
        },
        "causal_nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^N[0-9]+$"
              },
              "order": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "parents": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^N[0-9]+$"
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "analysis": {
                "type": "object",
                "properties": {
                  "statement": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "reasoning": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "assumptions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "minItems": 0,
                    "uniqueItems": true
                  },
                  "evidence_ids": {
                    "type": "array",
                    "items": {
                      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/evidence_id"
                    },
                    "minItems": 0,
                    "uniqueItems": true
                  },
                  "uncertainty": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "statement",
                  "reasoning",
                  "assumptions",
                  "evidence_ids",
                  "uncertainty"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "order",
              "parents",
              "analysis"
            ],
            "additionalProperties": false
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "consistency_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 0,
          "uniqueItems": true
        }
