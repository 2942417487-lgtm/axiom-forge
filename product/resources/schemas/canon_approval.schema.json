{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom-forge.invalid/schemas/canon_approval.schema.json",
  "title": "canon_approval",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "reviewed_at": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/datetime"
    },
    "decision_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/entity_id"
    },
    "bundle_sha256": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/sha256"
    },
    "task_sha256": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/sha256"
    },
    "proposal_hashes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/proposal_id"
      },
      "additionalProperties": {
        "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/sha256"
      }
    },
    "mac_sha256": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/sha256"
    }
  },
  "required": [
    "schema_version",
    "status",
    "reviewer",
    "reviewed_at",
    "decision_id",
    "bundle_sha256",
    "task_sha256",
    "proposal_hashes",
    "mac_sha256"
  ],
  "additionalProperties": false
}
