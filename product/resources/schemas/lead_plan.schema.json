{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom-forge.invalid/schemas/lead_plan.schema.json",
  "title": "lead_plan",
  "type": "object",
  "properties": {
    "world_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/world_id"
    },
    "task_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/task_id"
    },
    "run_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/run_id"
    },
    "agent_run_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/agent_run_id"
    },
    "artifact_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/artifact_id"
    },
    "canon_version": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/canon_version"
    },
    "result_type": {
      "const": "plan"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "researcher",
              "engineering_auditor",
              "economic_auditor",
              "historical_analyst"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "entity_ids": {
            "type": "array",
            "items": {
              "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/entity_id"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "required_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "role",
          "question",
          "entity_ids",
          "required_checks"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "metadata": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/metadata"
    }
  },
  "required": [
    "world_id",
    "task_id",
    "run_id",
    "agent_run_id",
    "artifact_id",
    "canon_version",
    "result_type",
    "summary",
    "assignments",
    "success_criteria",
    "open_questions",
    "metadata"
  ],
  "additionalProperties": false
}
