{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom-forge.invalid/schemas/historical_result.schema.json",
  "title": "historical_result",
  "type": "object",
  "properties": {
    "world_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/world_id"
    },
    "task_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/task_id"
    },
    "run_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/run_id"
    },
    "agent_run_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/agent_run_id"
    },
    "artifact_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/artifact_id"
    },
    "canon_version": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/canon_version"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "https://axiom-forge.invalid/schemas/claim.schema.json"
      },
      "minItems": 0
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "metadata": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/metadata"
    },
    "result_type": {
      "const": "historical"
    },
    "causal_chains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 2
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/evidence_id"
            },
            "minItems": 0
          }
        },
        "required": [
          "steps",
          "assumptions",
          "evidence_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "institutional_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "world_id",
    "task_id",
    "run_id",
    "agent_run_id",
    "artifact_id",
    "canon_version",
    "summary",
    "claims",
    "assumptions",
    "open_questions",
    "metadata",
    "result_type",
    "causal_chains",
    "institutional_constraints"
  ],
  "additionalProperties": false
}
