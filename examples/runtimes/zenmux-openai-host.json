  "limits": {"max_turns": 2, "timeout_seconds": 120, "max_output_tokens": 2048, "max_tool_calls": 1, "max_tool_result_bytes": 6400},
  "tools": {"capabilities": ["canon_read"], "enable_trusted_python": false}
}
