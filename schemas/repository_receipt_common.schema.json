{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom-forge.invalid/schemas/repository_receipt_common.schema.json",
  "title": "repository_receipt_common",
  "$defs": {
    "operation_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/repository_operation_id"
    },
    "receipt_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/repository_receipt_id"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_ref": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sha256": {
          "$ref": "https://axiom-forge.invalid/schemas/repository_receipt_common.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "record_id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "receipt_ref": {
      "type": "object",
      "properties": {
        "receipt_id": {
          "$ref": "https://axiom-forge.invalid/schemas/repository_receipt_common.schema.json#/$defs/receipt_id"
        },
        "sha256": {
          "$ref": "https://axiom-forge.invalid/schemas/repository_receipt_common.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "receipt_id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "git_commit_ref": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "object_format": {
              "const": "sha1"
            },
            "commit_oid": {
              "type": "string",
              "minLength": 40,
              "maxLength": 40,
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "required": [
            "object_format",
            "commit_oid"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "object_format": {
              "const": "sha256"
            },
            "commit_oid": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "object_format",
            "commit_oid"
          ],
          "additionalProperties": false
        }
      ]
    },
    "envelope": {
      "type": "object",
      "properties": {
        "receipt_format_version": {
          "type": "string",
          "const": "1.0"
        },
        "receipt_kind": {
          "enum": [
            "preparation",
            "inspection",
            "acceptance",
            "operation_result"
          ]
        },
        "operation_id": {
          "$ref": "https://axiom-forge.invalid/schemas/repository_receipt_common.schema.json#/$defs/operation_id"
        },
        "receipt_id": {
          "$ref": "https://axiom-forge.invalid/schemas/repository_receipt_common.schema.json#/$defs/receipt_id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        },
        "predecessor": {
          "anyOf": [
            {
              "$ref": "https://axiom-forge.invalid/schemas/repository_receipt_common.schema.json#/$defs/receipt_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "receipt_format_version",
        "receipt_kind",
        "operation_id",
        "receipt_id",
        "sequence",
        "recorded_at",
        "predecessor",
        "payload"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "https://axiom-forge.invalid/schemas/repository_receipt_common.schema.json#/$defs/receipt_ref"
    },
    {
      "$ref": "https://axiom-forge.invalid/schemas/repository_receipt_common.schema.json#/$defs/content_ref"
    },
    {
      "$ref": "https://axiom-forge.invalid/schemas/repository_receipt_common.schema.json#/$defs/git_commit_ref"
    }
  ]
}
