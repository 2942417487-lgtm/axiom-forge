{
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "checkpoint_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/checkpoint_id"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "previous_sha256": {
      "anyOf": [
        {
          "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/datetime"
    },
    "task_state": {
      "$ref": "https://axiom-forge.invalid/schemas/task_state.schema.json"
    },
    "state_sha256": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/sha256"
    },
    "control": {
      "type": "object",
      "properties": {
        "run_id": {
          "anyOf": [
            {
              "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/run_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_started_at": {
          "anyOf": [
            {
              "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/datetime"
            },
            {
              "type": "null"
            }
          ]
        },
        "host_config_sha256": {
          "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/sha256"
        },
        "policy_sha256": {
          "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/sha256"
        },
        "source_sha256": {
          "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/sha256"
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "stage": {
                "type": "string"
              },
              "agent_run_id": {
                "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/agent_run_id"
              },
              "input_path": {
                "type": "string"
              },
              "input_sha256": {
                "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/sha256"
              },
              "route": {
                "type": "object"
              },
              "amount_usd": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
              },
              "status": {
                "enum": [
                  "reserved",
                  "completed",
                  "failed",
                  "cancelled"
                ]
              },
              "packet_path": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "packet_sha256": {
                "anyOf": [
                  {
                    "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/sha256"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "role",
              "stage",
              "agent_run_id",
              "input_path",
              "input_sha256",
              "route",
              "amount_usd",
              "status",
              "packet_path",
              "packet_sha256"
            ],
            "additionalProperties": false
          }
        },
        "system_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "run_id",
        "run_started_at",
        "host_config_sha256",
        "policy_sha256",
        "source_sha256",
        "attempts"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "running",
        "interrupted",
        "waiting_approval",
        "approved",
        "applying",
        "completed",
        "rejected",
        "committed"
      ]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://axiom-forge.invalid/schemas/event_record.schema.json"
      }
    }
  },
  "required": [
    "schema_version",
    "checkpoint_id",
    "sequence",
    "previous_sha256",
    "created_at",
    "task_state",
    "state_sha256",
    "control",
    "status",
    "events"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom-forge.invalid/schemas/task_checkpoint.schema.json",
  "title": "task_checkpoint",
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          }
        }
      },
      "then": {
        "properties": {
          "control": {
            "required": [
              "system_version"
            ]
          }
        }
      }
    }
  ]
}
