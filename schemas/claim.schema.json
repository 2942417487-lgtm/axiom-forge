{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom-forge.invalid/schemas/claim.schema.json",
  "title": "claim",
  "type": "object",
  "properties": {
    "claim_id": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/claim_id"
    },
    "category": {
      "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/category"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/evidence_id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "entity_ids": {
      "type": "array",
      "items": {
        "$ref": "https://axiom-forge.invalid/schemas/common.schema.json#/$defs/entity_id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "reasoning": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1
    },
    "counterexamples": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "claim_id",
    "category",
    "statement",
    "evidence_ids",
    "entity_ids",
    "reasoning",
    "assumptions",
    "uncertainty",
    "counterexamples"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "category": {
            "enum": [
              "FACT",
              "INFERENCE"
            ]
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "evidence_ids": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
