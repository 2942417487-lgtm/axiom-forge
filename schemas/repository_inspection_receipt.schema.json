                {
                  "type": "null"
                }
              ]
            },
            "inspection_status": {
              "enum": [
                "eligible",
                "blocked",
                "incomplete"
              ]
            }
          },
          "required": [
            "preparation_ref",
            "source_capture_ref",
            "target_before_ref",
            "coverage_ref",
            "checks_ref",
            "comparison_ref",
            "write_projection_ref",
            "merge_verification_ref",
