{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom-forge.invalid/schemas/repository_inspection_receipt.schema.json",
  "title": "repository_inspection_receipt",
  "allOf": [
    {
      "$ref": "https://axiom-forge.invalid/schemas/repository_receipt_common.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "receipt_kind": {
          "const": "inspection"
